# Configuration Kapsule
KAPSULE_HOST=kapsule.nico7an.fr
KAPSULE_IMAGE=kapsule:latest
KAPSULE_MIDDLEWARES=public-shield@file
KAPSULE_URL=https://kapsule.nico7an.fr
# Ancien domaine, redirigé vers le nouveau
KAPSULE_ANCIEN_HOST=cyber.nico7an.fr

# Configuration SMTP pour l'envoi des OTP et invitations par e-mail
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_EMAIL=contact@nico7an.fr
# Mot de passe à saisir dans l'env de la stack Portainer (jamais écrasé par
# scripts/deployer.sh). À ne renseigner ici que pour un lancement local.
SMTP_PASSWORD=
SMTP_FROM="Kapsule <contact@nico7an.fr>"

# Options de production
KAPSULE_COOKIE_SECURISE=1
LOG_LEVEL=info
TZ=Europe/Paris
